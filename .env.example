# Copy to .env.local for local development. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used for Supabase's emailRedirectTo (email confirmation links). Set to the
# real deployed origin in production; http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# Added when background job processing / webhooks are implemented (Epic 4+/12) -
# this key bypasses Row Level Security. Never expose it to the client.
# SUPABASE_SERVICE_ROLE_KEY=
